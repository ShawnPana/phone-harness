{
  "name": "phone-harness",
  "version": "0.1.0",
  "description": "Drive a real phone from OpenClaw with one phone_exec tool",
  "type": "module",
  "license": "MIT",
  "homepage": "https://phone-harness.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phone-harness/phone-harness.git",
    "directory": "integrations/openclaw"
  },
  "files": [
    "assets",
    "classifier.py",
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-skill.mjs",
    "prepack": "npm run build",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "typebox": "1.3.37"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openclaw": "2026.10.9",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.9",
      "minGatewayVersion": "2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9",
      "pluginSdkVersion": "2026.10.9"
    },
    "install": {
      "clawhubSpec": "phone-harness",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.10.9"
    }
  }
}
