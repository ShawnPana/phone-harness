{
  "name": "@phone-harness/openclaw-plugin",
  "version": "0.1.0",
  "description": "Let your OpenClaw agent drive a real phone. Every script asks you first.",
  "type": "module",
  "license": "MIT",
  "author": "Shawn Pana",
  "homepage": "https://phone-harness.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnPana/phone-harness.git",
    "directory": "integrations/openclaw"
  },
  "bugs": "https://github.com/ShawnPana/phone-harness/issues",
  "keywords": ["openclaw", "phone", "iphone", "android", "automation"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-skill.mjs",
    "prepack": "npm run build",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "openclaw.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "typebox": "1.3.37"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.10.9",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.9",
      "minGatewayVersion": "2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9",
      "pluginSdkVersion": "2026.10.9"
    },
    "install": {
      "clawhubSpec": "@phone-harness/openclaw-plugin",
      "minHostVersion": ">=2026.10.9"
    }
  }
}
